# ローカルで Supabase に接続するときは .env にコピーして値を入れる（.env は git に入れない）
# Vercel では同じ名前で Project Settings > Environment Variables に登録する

DJANGO_SECRET_KEY=
# DJANGO_DEBUG=0
# 独自ドメインを使う場合のみ（カンマ区切り）
# DJANGO_ALLOWED_HOSTS=example.com

# Supabase > Connect > Transaction pooler (port 6543) の接続文字列
DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Supabase Storage（画像保存先）
SUPABASE_PROJECT_REF=xxxxxxxx
SUPABASE_STORAGE_BUCKET=entry-images
SUPABASE_STORAGE_REGION=ap-northeast-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
